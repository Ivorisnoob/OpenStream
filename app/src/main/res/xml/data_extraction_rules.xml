<?xml version="1.0" encoding="utf-8"?>
<!--
   Cloud backup and device-to-device transfer on Android 12+. The same choice as backup_rules.xml:
   the library database and the settings, nothing large or tied to this device.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="open_stream_prefs.xml" />
        <include domain="database" path="open_stream_db" />
        <include domain="database" path="open_stream_db-wal" />
        <include domain="database" path="open_stream_db-shm" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="open_stream_prefs.xml" />
        <include domain="database" path="open_stream_db" />
        <include domain="database" path="open_stream_db-wal" />
        <include domain="database" path="open_stream_db-shm" />
    </device-transfer>
</data-extraction-rules>
