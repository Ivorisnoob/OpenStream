<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Cold-start window: explicit background so launch never shows a bare color,
         and shortEdges so landscape video draws behind the cutout. Night mode is
         mirrored from the saved ThemeMode in MainActivity.onCreate. -->
    <style name="Theme.OpenStream" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
