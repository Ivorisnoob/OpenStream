<?xml version="1.0" encoding="utf-8"?>
<!-- The mini player's video. A TextureView draws inside Compose's layer, so the card's rounded
     clip, press ripple and swipe-to-dismiss fade apply to the video too; a SurfaceView would
     punch a square hole through all of them. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="zoom"
    app:shutter_background_color="@android:color/black" />
